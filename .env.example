# Jan Setu AI (जन सेतु) Environment Configuration Template
# Copy to .env for local deployment. Never commit real secret keys.

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./jan_setu.db
JANSETU_SECRET_KEY=generate-a-secure-random-argon2-key-here-for-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (Optional - RAG fallback active if not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:8000

